# Copy to .env (or .env.local) and fill in. Both are gitignored; .env.local wins if
# both exist. NEVER commit your real credentials.

# Required: your Overwolf account email (used in the auth header).
OVERWOLF_EMAIL=you@example.com

# Required: your Overwolf Developer Console API key.
# Console -> Settings -> Profile -> "Revoke and get new API key" (shown once — copy it immediately).
OVERWOLF_API_KEY=your-api-key

# Optional: default app ID used when a tool call omits app_id.
# OVERWOLF_DEFAULT_APP_ID=your-app-id

# Optional: override the API base URL (defaults to the value below).
# OVERWOLF_BASE_URL=https://console.overwolf.com/api/stats
