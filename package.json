{
  "name": "overwolf-console-mcp",
  "version": "0.1.2",
  "description": "Local stdio MCP server that wraps the Overwolf Developer Console statistics API, so MCP clients (Claude Desktop, etc.) can fetch an app's analytics on demand.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "overwolf",
    "analytics",
    "stats",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "author": "Counterwatch (https://counterwatch.gg)",
  "type": "module",
  "bin": {
    "overwolf-console-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Counterwatch/overwolf-console-mcp.git"
  },
  "homepage": "https://github.com/Counterwatch/overwolf-console-mcp#readme",
  "bugs": {
    "url": "https://github.com/Counterwatch/overwolf-console-mcp/issues"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "presmoke": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "prelive-check": "npm run build",
    "live-check": "node scripts/live-check.mjs",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
